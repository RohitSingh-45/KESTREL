# --- application ---------------------------------------------------------
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- storage -------------------------------------------------------------
# SQLite is the zero-setup default. Swap in Postgres for docker-compose:
# DATABASE_URL=postgresql+asyncpg://chainwatch:chainwatch@localhost:5432/chainwatch
DATABASE_URL=sqlite+aiosqlite:///./var/chainwatch.db
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# --- data sourcing --------------------------------------------------------
# live      = explorer APIs only
# synthetic = seeded demo dataset only (no network)
# hybrid    = try live, fall back to synthetic on failure or rate limit
DATA_MODE=hybrid

# Free-tier keys. Etherscan V2 covers ETH/BSC/Polygon/Arbitrum/Base with one key.
# https://etherscan.io/apis  |  https://www.trongrid.io  |  https://blockchair.com/api
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
BLOCKCHAIR_API_KEY=

# --- jobs -----------------------------------------------------------------
# inline = run traces in the API process (fine for a laptop demo)
# celery = dispatch to the worker container
JOB_BACKEND=inline

# --- tracing defaults -----------------------------------------------------
TRACE_MAX_HOPS=5
TRACE_MAX_FANOUT=25
TRACE_MIN_TAINT=0.01
VASP_TERMINAL_CONFIDENCE=0.75

# --- bootstrap admin ------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@chainwatch.gov.in
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe#123

# --- integrations ---------------------------------------------------------
NCRP_WEBHOOK_TOKEN=ncrp-dev-token
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
