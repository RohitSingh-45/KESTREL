# Leave EMPTY for:
# - Vite dev/preview (proxies /api → http://127.0.0.1:8000)
# - Same-origin production (FastAPI serves frontend/dist)
#
# REQUIRED for Vercel (or any static host) → separate API host:
# VITE_API_BASE_URL=https://YOUR-API.onrender.com
#
# If this is empty on a static host, the browser calls /api on the static
# host and you will see Request failed (502) / HTML-instead-of-JSON errors.
VITE_API_BASE_URL=
