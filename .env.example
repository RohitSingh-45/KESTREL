APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
# Local SQLite (default). Production Postgres example:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/kestrel
DATABASE_URL=sqlite+aiosqlite:///./data/kestrel.db
# Comma-separated browser origins for split FE/BE deploys (leave empty for same-origin)
CORS_ORIGINS=
# Optional; never commit real secrets
SECRET_KEY=
# Local: true heals empty SQLite after plain uvicorn. Production Docker uses
# scripts/start_production.py (alembic first) and may leave this false.
RUN_MIGRATIONS_ON_STARTUP=true
AGENT_CYCLE_SECONDS=600
GENERATION_LEASE_SECONDS=300

LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=3
LLM_PROBE_ON_STARTUP=true

RESEARCH_API_KEY=
RESEARCH_MAX_ITEMS=20
RESEARCH_RSS_URLS=https://feeds.feedburner.com/TheHackersNews,https://www.bleepingcomputer.com/feed/,https://www.schneier.com/feed/atom/
RESEARCH_HTTP_TIMEOUT_SECONDS=20
ARXIV_ENABLED=true
ARXIV_QUERY=AI security OR LLM security OR prompt injection OR adversarial machine learning
ARXIV_MAX_RESULTS=8
SQLITE_BUSY_TIMEOUT_MS=5000

TOPIC_FUNNEL_TOP_K=3
# Module 20 — reject generic cyber; keep AI/ML/LLM security only
AI_SECURITY_FILTER_ENABLED=true
SCORE_WEIGHT_RECENCY=0.15
SCORE_WEIGHT_PERSONA_FIT=0.15
SCORE_WEIGHT_IMPORTANCE=0.15
SCORE_WEIGHT_NOVELTY=0.10
SCORE_WEIGHT_SOURCE_QUALITY=0.10
SCORE_WEIGHT_EVIDENCE=0.10
SCORE_WEIGHT_AI_SECURITY=0.25

SOURCE_QUALITY_TIER1_DOMAINS=cisa.gov,nvd.nist.gov,nist.gov,cert.org,openai.com,anthropic.com,googleblog.com,microsoft.com,arxiv.org
SOURCE_QUALITY_TIER2_DOMAINS=schneier.com,bleepingcomputer.com,thehackernews.com,krebsonsecurity.com,darkreading.com,securityweek.com,wired.com,technologyreview.com
SOURCE_QUALITY_TIER3_DOMAINS=

DEBATE_TOP_K=3
DEBATE_MIN_CONFIDENCE=0.65
DEBATE_MIN_SCORE_FOR_PROCEED=0.60

MEMORY_MAX_ITEMS=10
MEMORY_MAX_SOURCE_URLS=10
MEMORY_EXTRACTION_ENABLED=true
MEMORY_MIN_CONFIDENCE=0.55

CONSISTENCY_ENABLED=true
CONSISTENCY_APPROVE_THRESHOLD=0.80
CONSISTENCY_REVISE_THRESHOLD=0.60
CONSISTENCY_MAX_REVISIONS=1
CONSISTENCY_HISTORY_LIMIT=10

SOURCE_DIVERSITY_LOOKBACK=10
SOURCE_DIVERSITY_MIN_SCORE=0.25
STORY_MATCH_THRESHOLD=0.70
STORY_LOOKBACK=20
CONTRADICTION_ENABLED=true
CONTRADICTION_MIN_CONFIDENCE=0.70
CONTRADICTION_MAX_ITEMS=10

ADAPTIVE_LEARNING_ENABLED=true
ADAPTIVE_LOOKBACK_POSTS=20
ADAPTIVE_MAX_SIGNALS=20
ADAPTIVE_MAX_CONTEXT_ITEMS=20
ADAPTIVE_STALE_DAYS=30
ADAPTIVE_DECAY_DAYS=30

EVALUATION_ENABLED=true
EVALUATION_REFLECTION_ENABLED=true
EVALUATION_LOOKBACK_POSTS=20
EVALUATION_EXCELLENT_THRESHOLD=0.85
EVALUATION_GOOD_THRESHOLD=0.70
EVALUATION_ACCEPTABLE_THRESHOLD=0.55
EVALUATION_WEAK_THRESHOLD=0.40
EVALUATION_FEEDBACK_DECAY_DAYS=30
EVALUATION_MAX_FEEDBACK_ITEMS=10

LEARNING_ENABLED=true
LEARNING_MIN_OBSERVATIONS=3
LEARNING_MIN_CONFIDENCE=0.65
LEARNING_MAX_SIGNALS=20
LEARNING_MAX_CONTEXT_ITEMS=20
LEARNING_DECAY_DAYS=30
LEARNING_LOOKBACK_EVALUATIONS=20

DECISION_ENABLED=true
DECISION_MIN_RESEARCH_ITEMS=1
DECISION_MIN_GROUNDED_ITEMS=1
DECISION_MIN_CANDIDATES=1
DECISION_MIN_SELECTED=1
DECISION_MIN_CONSISTENCY_SCORE=0.70
DECISION_ALLOW_UNCERTAIN_DEBATE=false
DECISION_MAX_TRACE_ITEMS=12

OBSERVABILITY_ENABLED=true
OBSERVABILITY_MAX_EVENTS=100
OBSERVABILITY_MAX_REASON_LENGTH=300
OBSERVABILITY_MAX_EVIDENCE_ITEMS=10
